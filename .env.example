# All values are optional; the defaults below are what the app uses.

# Where SQLite and extracted files live. On Vercel this is forced to /tmp.
# DATA_DIR=./data

# Any SQLAlchemy URL. Point this at Postgres for a persistent deployment:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/geoapi

# Upload guards
# MAX_UPLOAD_BYTES=52428800
# MAX_UNCOMPRESSED_BYTES=262144000
# MAX_ZIP_MEMBERS=200
# MAX_FEATURES=50000

# Comma-separated CORS origins
# ALLOWED_ORIGINS=https://your-app.vercel.app
